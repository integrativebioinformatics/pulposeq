/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running medium profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Must allow the doubled retry: the largest first attempt is bambu at 96 GB.
    resourceLimits = [ cpus: 32, memory: 208.GB, time: 12.h ]

    withLabel:process_reports {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:process_restrander {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_chopper {
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_minimap2 {
        cpus   = 32
        memory = { 48.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_nanocomp {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'PULPOSEQ:ALIGNMENT:NANOCOMP_MINIMAP2' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel:process_bambu {
        cpus   = 16
        memory = { 96.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_novel_transcripts {
        cpus   =  4
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_post_refinement {
        cpus   = 3
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_genomic_context {
        cpus   = 2
        memory = { 24.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_bam_coverage {
        cpus   = 2
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // oarfish (--run_oarfish). Not measured on a whole genome yet. The oarfish paper
    // (Fig. 3; COMBINE-lab/oarfish-paper-scripts) reports ~6 GB and ~0.2-0.3 h in read
    // mode for 14 M reads on the whole human transcriptome with 32 threads, without
    // bootstraps; memory grows with mapped reads. 32 GB covers roughly 75 M reads per
    // sample (150 M on retry).
    withLabel:process_high {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    // OARFISH_MERGE and CURATE hold every sample's bootstrap replicates: about
    // models x samples x replicates x 8 bytes, roughly tripled by R's copies.
    withName:OARFISH_MERGE {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    // Overrides base.config's CURATE rule. Without oarfish, CURATE keeps this
    // profile's process_low memory and time.
    withName:CURATE {
        memory = { (params.run_oarfish?.toString()?.toLowerCase() == 'true' ? 32.GB : 8.GB) * task.attempt }
        time   = { (params.run_oarfish?.toString()?.toLowerCase() == 'true' ? 2.h   : 1.h ) * task.attempt }
    }

}
