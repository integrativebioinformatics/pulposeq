/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running medium profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Must allow the doubled retry: the largest first attempt is bambu at 96 GB.
    resourceLimits = [ cpus: 32, memory: 208.GB, time: 12.h ]

    withLabel:process_reports {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:process_restrander {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_chopper {
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_minimap2 {
        cpus   = 32
        memory = { 48.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_nanocomp {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'PULPOSEQ:ALIGNMENT:NANOCOMP_MINIMAP2' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel:process_bambu {
        cpus   = 16
        memory = { 96.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_novel_transcripts {
        cpus   =  4
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_post_refinement {
        cpus   = 3
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_genomic_context {
        cpus   = 2
        memory = { 24.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_bam_coverage {
        cpus   = 2
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

}