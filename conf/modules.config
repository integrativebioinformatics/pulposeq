/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

/*
    Library strandedness is derived inline, as a single expression, inside each ext.args closure.

    The strict config parser (default from Nextflow 26.04) is restrictive here: it allows only config
    assignments, blocks and includes, so top-level `def` declarations and helper functions are
    rejected, and inside a config closure it rejects statement forms such as `switch` and `return`.
    Each closure body must therefore be one expression. Do not refactor these into a shared helper or
    a switch -- both fail to parse.

    The rule itself: ONT_DRS and PacBio are always stranded; ONT_cDNA follows --stranded_library.
    stranded_library is compared as a string so a CLI-supplied "false" is not coerced to true.
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: NANOCOMP_RAW {
        ext.args   = {"--plot violin"}
        publishDir = [
            path: { "${params.outdir}/nanocomp/raw_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NANOCOMP_REST {
        ext.args   = {"--plot violin"}
        publishDir = [
            path: { "${params.outdir}/nanocomp/rest_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NANOCOMP_CHOPPER {
        ext.args   = {"--plot violin"}
        publishDir = [
            path: { "${params.outdir}/nanocomp/filt_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NANOCOMP_MINIMAP2 {
        ext.args   = {"--plot violin"}
        publishDir = [
            path: { "${params.outdir}/nanocomp/mapping" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CHOPPER {
        ext.args2   = {"-q ${params.minqual} -l ${params.minlen}${params.maxlen ? " --maxlength ${params.maxlen}" : ''} --maxgc ${params.maxgc} --mingc ${params.mingc} --headcrop ${params.headcrop} --tailcrop ${params.tailcrop}"}
        ext.prefix = {"filtered_${meta.id}"}
        publishDir = [
            path: { "${params.outdir}/chopper" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

     withName: MINIMAP2_ALIGN {
        // Always -uf. Every route into alignment is oriented by then: ONT_DRS is
        // native RNA, PacBio is oriented by lima, and unoriented ONT_cDNA has been
        // through Restrander or the run has already stopped. The unstranded preset
        // has no remaining caller.
        //
        // --map_hq chooses between splice and splice:hq, the latter being `splice`
        // with -C5 -O6,24 -B4: a lower non-canonical junction penalty, costlier short
        // gaps, cheaper long ones, and a doubled mismatch penalty. It trusts the read,
        // reading a discrepancy as real biology rather than basecalling error.
        //
        // Left unset it resolves per library rather than to a single default, so that
        // adding the parameter changes nobody's results: splice:hq is minimap2's
        // documented Iso-Seq preset and stays PacBio's default, while ONT cDNA keeps
        // plain splice. Set explicitly, it overrides both, so either platform can be
        // run each way and compared.
        //
        // ONT_DRS is excluded entirely: -k14 is set to cope with a high error rate and
        // splice:hq asserts the opposite, so the two cannot both be right about the
        // same reads. Enforced in utils_nfcore_pulposeq_pipeline.
        ext.args   = {
            def hq = params.map_hq == null ? (params.library == 'PacBio')
                                           : params.map_hq
            params.library == 'ONT_DRS' ? '-ax splice -uf -k14'
                : hq ? '-ax splice:hq -uf'
                     : '-ax splice -uf'
        }
        publishDir = [
            path: { "${params.outdir}/minimap2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: BAM_COVERAGE {
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GENOMIC_CONTEXT {
        publishDir = [
            path: { "${params.outdir}/genomic_context" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: RESTRANDER {
        publishDir = [
            path: { "${params.outdir}/restrander" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BAMBU {
        // Unconditionally stranded: the pipeline does not admit unoriented reads to
        // this point. Losing strand erases mono-exonic novel transcripts, inflates
        // antisense calls and bleeds reads between overlapping sense/antisense pairs,
        // so a run that cannot establish strand stops rather than proceeding.
        ext.args   = {
            "--ndr ${params.ndr} --stranded true"
        }
        publishDir = [
            [
                path: { "${params.outdir}/bambu" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    ['versions.yml', 'bambu_run_metrics.csv', 'bambu_console.log'].contains(filename) ? null : filename
                }
            ],
            [
                // Copied, not symlinked. These two exist so the run's parameters
                // outlive the work directory, and the default symlink mode leaves
                // dangling links as soon as work/ is cleaned. 4.7 KB between them.
                path: { "${params.outdir}/bambu" },
                mode: 'copy',
                pattern: '{bambu_run_metrics.csv,bambu_console.log}'
            ]
        ]
    }

    withName: GFFCOMPARE {
        ext.prefix = 'compared'  // optional: match old output filenames
        publishDir = [
            path: { "${params.outdir}/gffcompare" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GFFREAD {
        ext.args   = "-w"
        publishDir = [
            path: { "${params.outdir}/gffread" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Both coding-potential predictors publish to the same directory, named for the
    // step rather than the tool, so a run is comparable with one that used the other.
    // Which produced it is recorded per transcript in the novel metadata's
    // coding_predictor column, and in versions.yml.
    withName: RNAMINING {
        publishDir = [
            path: { "${params.outdir}/coding_potential" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CPC2 {
        publishDir = [
            path: { "${params.outdir}/coding_potential" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FILTER_BAMBU_COUNTS {
        publishDir = [
            path: { "${params.outdir}/bambu_filter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NOVEL_TRANSCRIPTS {
        publishDir = [
            path: { "${params.outdir}/novel_transcripts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: VALIDATE_BAMBU_COUNTS {
        publishDir = [
            path: { "${params.outdir}/bambu_validated" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: REF_TRANSCRIPTS {
        publishDir = [
            path: { "${params.outdir}/ref_transcripts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Not published: these GTFs are intermediates. ENRICH_VALIDATED_GTF adds the
    // biotype and classification attributes and publishes the same filenames.
    withName: VALIDATE_BAMBU_GTF {
        publishDir = [ enabled: false ]
    }

    withName: ANNOTATION {
        publishDir = [
            path: { "${params.outdir}/bambu_validated" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: VALIDATE_BAMBU_OUTPUTS {
        publishDir = [
            [
                path: { "${params.outdir}/bambu_validated" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    ['versions.yml', 'validation_summary.csv'].contains(filename) ? null : filename
                }
            ],
            [
                path: { "${params.outdir}/bambu_validated" },
                mode: 'copy',
                pattern: 'validation_summary.csv'
            ]
        ]
    }

    withName: RENDER_REPORT {
        publishDir = [
            path: { "${params.outdir}/transcriptome_report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
