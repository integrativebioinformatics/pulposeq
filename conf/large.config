/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running large profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile for large fastq and bam files
*/

process {
    resourceLimits = [ cpus: 48, memory: 1000.GB, time: 48.h ]

    withLabel:process_reports {
        cpus   =  1
        memory = 12.GB
        time   = 1.h
    }
    withLabel:process_low {
        cpus   =  3
        memory = 12.GB
        time   = 1.h
    }
    withLabel:process_restrander {
        cpus   =  2
        memory = 5.GB
        time   = 8.h
    }
    withLabel:process_chopper {
        cpus   =  2
        memory = 400.GB
        time   = 12.h
    }
    withLabel:process_minimap2 {
        cpus   = 32
        memory = 100.GB
        time   = 12.h
    }
    withLabel:process_nanocomp {
        cpus   =  3
        memory = 100.GB
        time   = 12.h
    }
    withName: 'PULPOSEQ:ALIGNMENT:NANOCOMP_MINIMAP2' {
        cpus   =  7
        memory = 300.GB
        time   = 12.h
    }
    withLabel:process_bambu {
        cpus = 4
        memory = 1000.GB
        time = 48.h
    }
    withLabel:process_novel_transcripts {
        cpus   =  4
        memory = 32.GB
        time   = 4.h
    }
    withLabel:process_post_refinement {
        cpus   =  8
        memory = 150.GB
        time   = 4.h
    }
    withLabel:process_genomic_context {
        cpus   =  2
        memory = 12.GB
        time   = 4.h
    }
    withLabel:process_bam_coverage {
        cpus   = 4
        memory = 8.GB
        time   = 6.h
    }

    // oarfish (--run_oarfish). Not measured on a whole genome yet. The oarfish paper
    // (Fig. 3; COMBINE-lab/oarfish-paper-scripts) reports ~6 GB and ~0.2-0.3 h in read
    // mode for 14 M reads on the whole human transcriptome with 32 threads, without
    // bootstraps; memory grows with mapped reads. 96 GB covers roughly 220 M reads
    // per sample.
    withLabel:process_high {
        cpus   = 48
        memory = 80.GB
        time   = 12.h
    }
    // OARFISH_MERGE and CURATE hold every sample's bootstrap replicates: about
    // models x samples x replicates x 8 bytes, roughly tripled by R's copies.
    withName:OARFISH_MERGE {
        cpus   =  1
        memory = 5.GB
        time   = 4.h
    }
    // Overrides base.config's CURATE rule. Without oarfish, CURATE keeps this
    // profile's process_low memory and time.
    withName:CURATE {
        memory = { params.run_oarfish?.toString()?.toLowerCase() == 'true' ? 80.GB : 10.GB }
        time   = { params.run_oarfish?.toString()?.toLowerCase() == 'true' ? 4.h    : 1.h   }
    }

}
