/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/
process {

    // Must allow a doubled retry: the largest first attempt is minimap2 at 20 GB,
    // so anything below 40 GB would silently clamp the escalation and the retry
    // would fail identically. Tune to your hardware, but keep that relationship.
    resourceLimits = [ cpus: 16, memory: 48.GB, time: 8.h ]

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + [104] + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = -1

    // Sized from a measured test run. cpus are fixed because retries address
    // out-of-memory and timeout failures, not a shortage of cores.
    withLabel:process_reports {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = 3
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    // Estimated, not measured. Restrander streams a FASTQ record at a time and only
    // inspects the first and last few hundred bases of each, so memory should stay
    // well under this -- unlike Chopper, whose buffering makes it scale with input
    // size. The I/O is comparable though, so time is sized against Chopper's.
    withLabel:process_restrander {
        cpus   = 2
        memory = { 1.GB * task.attempt }
        time   = { 3.h  * task.attempt }
    }
    withLabel:process_chopper {
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_minimap2 {
        cpus   = 8
        memory = { 20.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_nanocomp {
        cpus   = 3
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel:process_bambu {
        cpus   = 3
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_novel_transcripts {
        cpus   =  4
        memory = { 10.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    // VALIDATE_BAMBU_OUTPUTS (the only process with this label): loads Bambu's
    // transcript and gene objects, whose exon ranges grow with the annotation, plus
    // oarfish's tables when it ran. Measured 1.7 GB on a chromosome 1 test run, so 2 GB
    // left no headroom for a whole-genome annotation.
    withLabel:process_post_refinement {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    // Dominated by makeTxDbFromGFF on the validated annotation, which parses the
    // whole GTF into a database before a single figure is drawn. Drawing itself is
    // cheap: a handful of bigWig range queries per gene.
    withLabel:process_genomic_context {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    // Reads alignments through the index, one contig at a time, so peak memory
    // tracks the largest chromosome rather than the whole BAM. Not process_low:
    // that label is for the small R metadata steps.
    withLabel:process_bam_coverage {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 3.h  * task.attempt }
    }

    // nf-core's oarfish module (one task per sample). Measured on a chromosome 1 test
    // run (chr1 transcriptome, 4 PacBio samples, 30 bootstraps): at most 0.96 GB and 10 min
    // per sample, using about 6 of 8 cores. A whole transcriptome has roughly 10 times
    // the index and many more mapped reads; the oarfish paper reports ~5 GB and 6-22 min
    // on whole human transcriptomes. 16 GB and 4 h leave room for that.
    withLabel:process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // Holds every sample's oarfish counts and bootstrap replicates in memory: about
    // models x samples x replicates x 8 bytes (250,000 models, 24 samples and 30
    // replicates is ~1.4 GB) before R's copies. Measured 0.36 GB and 5 s on the
    // chromosome 1 test run.
    withName:OARFISH_MERGE {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    // CURATE reads the same bootstrap replicates as OARFISH_MERGE and builds the
    // curated SummarizedExperiment from them, so with oarfish it needs the same
    // memory. Without oarfish it only subsets text tables (measured 0.74 GB with
    // oarfish on the chromosome 1 test run), and process_low is enough.
    withName:CURATE {
        memory = { (params.run_oarfish?.toString()?.toLowerCase() == 'true' ? 8.GB : 2.GB) * task.attempt }
    }

}
