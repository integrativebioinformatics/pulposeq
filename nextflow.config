/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Skips
    // skip_nanocomp takes any combination of raw, restrander, chopper, minimap2 --
    // or all -- comma-separated, e.g. 'raw,chopper'. Unset runs every report.
    skip_nanocomp              = null
    skip_chopper               = false
    skip_minimap2              = false
    skip_bambu                 = false
    skip_class                 = false

    // Input options
    input                      = null

    // Filtering raw reads options
    minqual                    = 0
    minlen                     = 300
    maxlen                     = null
    maxgc                      = 1
    mingc                      = 0
    headcrop                   = 0
    tailcrop                   = 0

    // Bambu options
    ndr                        = null

    // Restranding options (unoriented ONT cDNA only)
    restrand_kit               = null
    restrand_config            = null
    restrand_min_frac          = 0.8

    // Alignment options
    library                    = null
    stranded_library           = false
    // Three states, not two. Unset means "use the preset that suits this library":
    // splice:hq for PacBio, splice for ONT. Setting it true or false overrides that
    // for ONT_cDNA and PacBio alike, so either can be run both ways and compared.
    map_hq                     = null
    bam_format                 = true
    cigar_paf_format           = false
    cigar_bam                  = false
    bam_index_extension        = 'bai'

    // Coding prediction options
    coding_potential_pred      = 'cpc2'
    organism                   = null

    // Ensembl references setup
    reference                  = null
    annotation                 = null

    // MultiQC
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    multiqc_methods_description = null

    // Boilerplate options
    outdir                     = null
    publish_dir_mode           = 'symlink'
    monochrome_logs            = false
    help                       = false
    help_full                  = false
    show_hidden                = false
    version                    = false
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
    
    // Schema validation default options
    validate_params            = true
}

// Load base.config by default
includeConfig 'conf/base.config'

profiles {
    debug {
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g) --cap-add SYS_ADMIN --device /dev/fuse --security-opt apparmor=unconfined'
        singularity.enabled    = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
        conda.enabled          = false
    }
    test      { includeConfig 'conf/test.config'      }
    medium    { includeConfig 'conf/medium.config'    }
    large     { includeConfig 'conf/large.config'     }
}

// Set default registry for Apptainer, Docker, Podman and Singularity independent of -profile
apptainer.registry   = 'quay.io'
docker.registry      = 'quay.io'
singularity.registry = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'integrativebioinformatics/pulposeq'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Bárbara Borges',
            affiliation: 'Integrative Bioinformatics',
            email: 'mbarborgess@gmail.com',
            github: '@borgessbarbara',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: 'http://orcid.org/0009-0002-1064-0338'
        ],
        [
            name: 'Lucas Freitas',
            affiliation: 'Staatliches Museum für Naturkunde Stuttgart',
            github: '@lfreitasl',
            contribution: ['contributor', 'maintainer'],
            orcid: 'https://orcid.org/0009-0007-4564-5389'
        ],
        [
            name: 'Gleison Medeiros',
            affiliation: 'Bioinformatics Multidisciplinary Environment',
            github: '@gleisonm',
            contribution: ['contributor'],
            orcid: ''
        ],
        [
            name: 'João Victor Cavalcante',
            affiliation: 'Bioinformatics Multidisciplinary Environment',
            github: '@jvfe',
            contribution: ['contributor'],
            orcid: ''
        ],
        
    ]
    homePage        = 'https://github.com/integrativebioinformatics/pulposeq'
    description     = """A pipeline for isoform-level transcriptome assembly and lncRNA discovery from long-reads"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.0'
    version         = '1.0.0'
    doi             = ''
}

// Nextflow plugins
plugins {
    id "nf-schema@2.7.2"
}

validation {
    monochromeLogs = params.monochrome_logs
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
